{
  "name": "@cocreate/element-prototype",
  "version": "1.38.0",
  "description": "A simple element-prototype component in vanilla javascript. Easily configured using HTML5 data-attributes and/or JavaScript API.",
  "keywords": [
    "element-prototype",
    "low-code",
    "realtime",
    "realtime-framework",
    "collaboration",
    "shared-editing",
    "html5-framework",
    "javascript-framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "client"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "A simple element-prototype component in vanilla javascript. Easily configured using HTML5 data-attributes and/or JavaScript API.",
      "source": "src/index.js",
      "declarative": {
        "attributes": [
          {
            "name": "array"
          },
          {
            "name": "component"
          },
          {
            "name": "contenteditable"
          },
          {
            "name": "editor"
          },
          {
            "name": "key"
          },
          {
            "name": "locale"
          },
          {
            "name": "multiple"
          },
          {
            "name": "now"
          },
          {
            "name": "object"
          },
          {
            "name": "set-value-prefix"
          },
          {
            "name": "set-value-suffix"
          },
          {
            "name": "src"
          },
          {
            "name": "srcdoc"
          },
          {
            "name": "state_id"
          },
          {
            "name": "time-ago-limit"
          },
          {
            "name": "time-to-units"
          },
          {
            "name": "type"
          },
          {
            "name": "use-utc"
          },
          {
            "name": "value"
          },
          {
            "name": "week-start-day"
          }
        ]
      },
      "api": {
        "exports": [
          "getAttribute",
          "getValue",
          "queryElements",
          "setValue"
        ]
      }
    }
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/cocreatejs/CoCreate-element-prototype.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-element-prototype/issues"
  },
  "homepage": "https://cocreate.app/docs/element-prototype",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/utils": "^1.54.0"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.9.0"
  },
  "allowScripts": {
    "@cocreate/utils@1.42.2": true,
    "@cocreate/webpack@1.4.3": true
  }
}
